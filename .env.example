# BabyGuard Environment Variables
# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXTAUTH_URL=http://localhost:3000

# IMPORTANTE DE SEGURANÇA:
# NUNCA insira SUPABASE_SERVICE_ROLE_KEY no frontend nem com prefixo NEXT_PUBLIC_!
# A chave de serviço só deve existir no ambiente de servidor seguro da Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# WEBRTC / TURN CONFIGURATION (Opcional - fallback para redes restritas)
# Exemplo com provedor TURN (ex: Cloudflare Calls, Metered, Twilio ou CoTURN próprio)
TURN_SERVER_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET_KEY=

# APP
NEXT_PUBLIC_APP_URL=https://babyguard.vercel.app
